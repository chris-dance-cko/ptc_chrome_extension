{
  "manifest_version": 3,
  "name": "Extension",
  "version": "1.0",
  "permissions": [
    "tabs",
    "storage",
    "bookmarks",
    "alarms",
    "sidePanel",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Click to open side panel"
  }
}
